# Server-side only. Copy to .env.local; never commit populated credentials.
NEBIUS_API_KEY=
# Copy endpoint and NVIDIA model ID from your Nebius console.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_TIMEOUT_MS=45000
# Optional for future authenticated repository reads. Use least privilege.
GITHUB_TOKEN=
# Optional remote sandbox adapter. Use a disposable Token Factory Sandbox endpoint.
SANDBOX_API_KEY=
SANDBOX_BASE_URL=
SANDBOX_TIMEOUT_MS=120000
SANDBOX_COMMANDS=npm ci,npm run check
